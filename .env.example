# TEND environment — API keys & runtime config
# Gitignored (.gitignore: `.env`). Replace placeholders with your own credentials.

# ---- LLM provider (OpenAI-compatible) ----
# Defaults below mirror tend/config.py (DeepSeek). Swap for OpenAI / other provider as needed.
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_BASE_URL=your-openai-base-url-here

# ---- MongoDB ----
TEND_MONGO_URI=your-mongodb-uri-here

# ---- Optional runtime toggles (see tend/config.py) ----
# TEND_MODEL=deepseek-v4-flash  # chat model id (default: deepseek-v4-flash)
# TEND_LLM_STUB=0              # 1 = offline stub mode (no live API)
# TEND_LLM_MAX_CONCURRENCY=16  # bounds concurrent LLM calls; set 0 to run unbounded
# TEND_QUIET=0
