{
  "pattern_family": "simple_filter",
  "primary_operator": "$match",
  "must_contain": [
    "$match",
    "$project"
  ],
  "must_contain_at_root": [
    "$match",
    "$project"
  ],
  "query": "db.students.aggregate([ { $match: { \"exam_scores\": { $gt: 70 } } }, { $project: { _id: 0, name: 1, exam_scores: \"$exam_scores\" } }])"
}