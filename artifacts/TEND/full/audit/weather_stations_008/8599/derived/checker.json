{
  "pattern_family": "time_window_aggregate",
  "primary_operator": "$group",
  "must_contain": [
    "$group",
    "$sort"
  ],
  "must_contain_at_root": [
    "$group",
    "$project",
    "$sort"
  ],
  "query": "db.readings.aggregate([ { $sort: { \"month\": 1 } }, { $group: { _id: \"$month\", avg_value: { $avg: \"$temperature\" } } }, { $project: { _id: 0, bucket: \"$_id\", avg_value: 1 } }])"
}