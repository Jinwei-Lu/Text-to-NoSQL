{
  "pattern_family": "type_introspection",
  "primary_operator": "$type",
  "must_contain": [
    "$group",
    "$type"
  ],
  "must_contain_at_root": [
    "$group",
    "$project"
  ],
  "query": "db.courses.aggregate([ { $group: { _id: { $type: \"$avg_score\" }, count: { $sum: 1 } } }, { $project: { _id: 0, field_type: \"$_id\", count: 1 } }])"
}