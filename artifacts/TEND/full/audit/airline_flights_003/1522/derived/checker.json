{
  "pattern_family": "array_positional_select",
  "primary_operator": "$arrayElemAt",
  "must_contain": [
    "$arrayElemAt",
    "$project"
  ],
  "must_contain_at_root": [
    "$project"
  ],
  "query": "db.flights.aggregate([ { $project: { _id: 0, airline: 1, first: { $arrayElemAt: [\"$ticket_prices\", 0] }, last: { $arrayElemAt: [\"$ticket_prices\", -1] }, size: { $size: \"$ticket_prices\" } } }])"
}