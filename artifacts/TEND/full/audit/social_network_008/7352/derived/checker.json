{
  "pattern_family": "array_positional_select",
  "primary_operator": "$arrayElemAt",
  "must_contain": [
    "$arrayElemAt",
    "$project"
  ],
  "must_contain_at_root": [
    "$project"
  ],
  "query": "db.posts.aggregate([ { $project: { _id: 0, author: 1, first: { $arrayElemAt: [\"$engagement_scores\", 0] }, last: { $arrayElemAt: [\"$engagement_scores\", -1] }, size: { $size: \"$engagement_scores\" } } }])"
}