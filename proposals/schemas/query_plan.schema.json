{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tend.dev/schemas/query_plan.schema.json",
  "title": "ARCHIVAL NON-ACTIVE: TEND Legacy QPS Query Plan Output",
  "description": "Archival schema for the pre-RAR operator-centric QPS output. Active QPS output is schemas/intent.schema.json.",
  "deprecated": true,
  "x-status": "archival-non-active",
  "type": "object",
  "additionalProperties": false,
  "required": ["query_plan", "qps_trace"],
  "properties": {
    "query_plan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "primary_pattern",
        "operator_graph",
        "shape_policy",
        "null_missing_strategy",
        "target_difficulty",
        "schema_flex_mode",
        "join_depth_target",
        "aggregation_depth_target",
        "target_fields",
        "semantic_properties"
      ],
      "properties": {
        "primary_pattern": {
          "type": "string",
          "minLength": 1,
          "description": "Primary pattern ID (e.g. window_facet_filter, polymorphic_dispatch)."
        },
        "operator_graph": {
          "type": "object",
          "additionalProperties": false,
          "required": ["stages"],
          "properties": {
            "stages": {
              "type": "array",
              "minItems": 1,
              "items": { "type": "string", "minLength": 1 }
            },
            "dependencies": {
              "type": "array",
              "items": { "type": "string", "minLength": 1 }
            }
          }
        },
        "shape_policy": {
          "type": "string",
          "enum": ["preserve", "reshape", "reduce"]
        },
        "null_missing_strategy": {
          "type": "string",
          "enum": ["none", "ifNull", "type", "cond"]
        },
        "target_difficulty": {
          "type": "string",
          "enum": ["L0", "L1", "L2", "L3", "L4"]
        },
        "schema_flex_mode": {
          "type": "string",
          "enum": ["none", "polymorphic", "attribute_bag", "schema_versioning", "dynamic_key"]
        },
        "join_depth_target": {
          "type": "integer",
          "minimum": 0,
          "maximum": 8
        },
        "aggregation_depth_target": {
          "type": "string",
          "enum": ["shallow", "medium", "deep"]
        },
        "target_fields": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "semantic_properties": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "expect"],
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "expect": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    },
    "qps_trace": {
      "type": "object",
      "additionalProperties": false,
      "required": ["coverage_cell", "deficit_weight", "supply_constrained"],
      "properties": {
        "coverage_cell": { "type": "string", "minLength": 1 },
        "deficit_weight": { "type": "number", "minimum": 0 },
        "supply_constrained": { "type": "boolean" },
        "pattern_rationale": { "type": "string", "minLength": 1 },
        "skip_reason": { "type": "string", "minLength": 1 }
      }
    }
  }
}
