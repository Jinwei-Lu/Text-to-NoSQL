{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tend.dev/schemas/library.schema.json",
  "title": "TEND BIRD Database Catalog",
  "description": "JSON Schema for bird_db_catalog.json, which tend validate checks in a construct dataset.",
  "$defs": {
    "birdDbEntry": {
      "type": "object",
      "required": [
        "db_id",
        "domain_id",
        "sqlite_path",
        "table_count",
        "query_count",
        "selected",
        "flex_eligible"
      ],
      "additionalProperties": false,
      "properties": {
        "db_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "domain_id": {
          "type": "string",
          "minLength": 1
        },
        "sqlite_path": {
          "type": "string",
          "minLength": 1
        },
        "table_count": {
          "type": "integer",
          "minimum": 1
        },
        "query_count": {
          "type": "integer",
          "minimum": 1
        },
        "selected": {
          "type": "boolean"
        },
        "flex_eligible": {
          "type": "boolean"
        },
        "selection_reason": {
          "type": "string"
        },
        "reject_reason": {
          "type": "string"
        }
      }
    },
    "bird_db_catalog": {
      "type": "object",
      "required": [
        "source_version",
        "generated_at",
        "databases"
      ],
      "additionalProperties": false,
      "properties": {
        "source_version": {
          "type": "string",
          "minLength": 1
        },
        "generated_at": {
          "type": "string",
          "format": "date-time"
        },
        "bird_root": {
          "type": "string"
        },
        "selection_policy": {
          "type": "object",
          "properties": {
            "min_tables": {
              "type": "integer",
              "minimum": 1
            },
            "min_queries": {
              "type": "integer",
              "minimum": 1
            },
            "require_non_empty_data": {
              "type": "boolean"
            },
            "min_flex_db_ratio": {
              "type": "number",
              "minimum": 0,
              "maximum": 1,
              "description": "Minimum share of selected DBs with flex_eligible=true (default 0.30)."
            }
          },
          "additionalProperties": false
        },
        "databases": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/birdDbEntry"
          }
        }
      },
      "description": "bird_db_catalog.json: the BIRD mini-dev databases a tend construct run built, with their source statistics."
    }
  },
  "$ref": "#/$defs/bird_db_catalog"
}
