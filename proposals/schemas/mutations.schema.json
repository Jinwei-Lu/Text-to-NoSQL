{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tend.dev/schemas/mutations.schema.json",
  "title": "TEND per-record mutations file",
  "description": "Plausible wrong MQL variants for P3 discriminativeness; 5–8 entries per record.",
  "type": "object",
  "additionalProperties": false,
  "required": ["record_id", "db_id", "mutations"],
  "properties": {
    "record_id": {
      "type": "integer",
      "minimum": 1
    },
    "db_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "mutations": {
      "type": "array",
      "minItems": 5,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "mutation_id",
          "dimension",
          "subaxis",
          "MQL",
          "expected_reject"
        ],
        "properties": {
          "mutation_id": {
            "type": "string",
            "pattern": "^m[0-9]{3}$"
          },
          "dimension": {
            "type": "string",
            "enum": ["A", "B", "C", "D"]
          },
          "subaxis": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string"
          },
          "MQL": {
            "type": "string",
            "minLength": 1
          },
          "expected_reject": {
            "type": "boolean",
            "const": true
          }
        }
      }
    }
  }
}
