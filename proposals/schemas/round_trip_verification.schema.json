{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tend.dev/schemas/round_trip_verification.schema.json",
  "title": "TEND RTV Agent Output",
  "description": "Round-trip verification output from RTV: independent NL→MQL synthesis compared to gold by result equivalence, not cfs fingerprint.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mql_round_trip_canonical",
    "mql_round_trip_colloquial",
    "round_trip_verification",
    "rtv_pass",
    "rtv_trace"
  ],
  "properties": {
    "mql_round_trip_canonical": {
      "type": "string",
      "minLength": 1
    },
    "mql_round_trip_colloquial": {
      "type": "string",
      "minLength": 1
    },
    "round_trip_verification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["canonical_pass", "colloquial_pass"],
      "properties": {
        "canonical_pass": { "type": "boolean" },
        "canonical_result_equiv": { "type": "boolean" },
        "colloquial_pass": { "type": "boolean" },
        "colloquial_result_equiv": { "type": "boolean" },
        "underspec_attribution": { "type": "string", "minLength": 1 }
      }
    },
    "rtv_pass": { "type": "boolean" },
    "rtv_trace": {
      "type": "object",
      "additionalProperties": false,
      "required": ["retry_count"],
      "properties": {
        "retry_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2
        },
        "reflux_recommendation": {
          "type": ["string", "null"]
        }
      }
    }
  }
}
