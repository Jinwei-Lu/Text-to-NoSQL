{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tend.dev/schemas/migration_log.schema.json",
  "title": "TEND DM Migration Log",
  "description": "Row-level migration trace produced by DM (Data Migrator) for a Spider db_id.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "db_id",
    "generated_at",
    "source_sqlite",
    "target_collections",
    "world_signature",
    "stats",
    "entries",
    "integrity_checks"
  ],
  "properties": {
    "db_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "source_sqlite": {
      "type": "string",
      "minLength": 1
    },
    "target_collections": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "world_signature": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "stats": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_rows", "target_documents", "tables_migrated"],
      "properties": {
        "source_rows": { "type": "integer", "minimum": 0 },
        "target_documents": { "type": "integer", "minimum": 1 },
        "tables_migrated": { "type": "integer", "minimum": 1 }
      }
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/migrationEntry" }
    },
    "integrity_checks": {
      "type": "object",
      "additionalProperties": false,
      "required": ["referential_pass", "row_count_reconciled", "orphan_refs"],
      "properties": {
        "referential_pass": { "type": "boolean" },
        "row_count_reconciled": { "type": "boolean" },
        "orphan_refs": { "type": "integer", "minimum": 0 }
      }
    }
  },
  "$defs": {
    "migrationEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "entry_id",
        "source_table",
        "source_pk",
        "target_collection",
        "target_id",
        "operation"
      ],
      "properties": {
        "entry_id": {
          "type": "string",
          "pattern": "^M[0-9]{4,}$"
        },
        "source_table": { "type": "string", "minLength": 1 },
        "source_pk": { "type": "string", "minLength": 1 },
        "target_collection": { "type": "string", "minLength": 1 },
        "target_id": {
          "oneOf": [
            { "type": "string", "minLength": 1 },
            { "type": "integer" }
          ]
        },
        "operation": {
          "type": "string",
          "enum": ["root_insert", "embed_push", "field_denorm", "ref_link"]
        },
        "target_path": {
          "oneOf": [
            { "type": "string", "minLength": 1 },
            { "type": "null" }
          ]
        },
        "embedded_children": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    }
  }
}
