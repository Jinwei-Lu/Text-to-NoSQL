# ============================================================
# Local machine / editor state
# ============================================================
.DS_Store
Thumbs.db
/.vscode/
/.idea/
/.cursor/
/.claude/
*.swp
*.swo

# ============================================================
# Python bytecode, build output, and test caches
# ============================================================
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
wheels/
.eggs/
*.egg-info/
*.egg
.installed.cfg

.pytest_cache/
.mypy_cache/
.ruff_cache/
.pyre/
.nox/
.tox/
.hypothesis/
.coverage
.coverage.*
coverage.xml
htmlcov/

# ============================================================
# Jupyter
# ============================================================
.ipynb_checkpoints/
*.nbconvert.ipynb

# ============================================================
# Virtual environments and local secrets
# ============================================================
.env
.env.*
!.env.example
.venv/
venv/
ENV/
env/

*.key
*.pem
secrets.json

# ============================================================
# Logs and generic local caches
# ============================================================
*.log
.cache/
cache/
.uv-cache/
tmp/

# ============================================================
# Source data, dataset release, and experiment outputs
# ============================================================
# BIRD mini-dev source databases; only needed to rebuild the benchmark.
/minidev/

# The dataset release lives on Google Drive (see README.md); restore it here.
# TEND is schema-less: no schema file is distributed.
/release/

# Run directories written by the CLI: predictions, logs, transcripts, reports.
/runs/

# Result bundles and staging areas built from runs/.
/artifacts/
/output/
/drive_upload/

# ============================================================
# QueryCraft demo: source is public, data, media, and deployment are local
# ============================================================
/demonstration/mongodb_data/
/demonstration/mongodb_schema/
/demonstration/schemas/
/demonstration/*.mp4
# QueryCraft Sites deployment (separate repository) and its export tooling.
/demonstration/querycraft-sites/
/demonstration/scripts/
/demonstration/tests/test_querycraft_catalog_export.py

# ============================================================
# Project-internal material that is not part of the public release
# ============================================================
# proposals/: only the files the code reads at runtime are public (the baseline
# allow list and the record/library/rationale JSON schemas); the design proposals
# and schema fixtures stay local.
/proposals/*
!/proposals/schemas/
/proposals/schemas/*
!/proposals/schemas/solver_allow_list.json
!/proposals/schemas/record.schema.json
!/proposals/schemas/library.schema.json
!/proposals/schemas/agent_design_rationale.schema.json
/docs/
/tests/
/scripts/
/CLAUDE.md
/uv.lock

# Paper, demo-paper, and poster sources live in their own repositories.
/Paper/
/paper_demo/
/poster_demo/
/querycraft_a0_conference_poster/

# ============================================================
# Model weights / large binary artifacts
# ============================================================
*.pth
*.pt
*.ckpt
*.onnx
*.gguf
*.tar.zst
