# ============================================================
# Generated benchmark, experiment, and analysis output
# ============================================================
/vector_store/
/runs/
/results/
/error_case/
/error_analysis/
/output/
/outputs/
/drive_upload/*
!/drive_upload/README.md
!/drive_upload/SHA256SUMS.txt
!/drive_upload/raw_mongodb_data_checksums_and_sizes.txt

# Formal releases are distributed through Drive. Keep only the lightweight
# README/VERSION/external manifest surface in git; generated dataset payloads,
# schemas, audits, metadata, statistics, and raw MongoDB exports stay local.
/release/*/data/
/release/*/audits/
/release/*/metadata/
/release/*/schema/
/release/*/statistics/
/release/**/mongodb_data/*
!/release/**/mongodb_data/README.md

# Local staging copies and intermediate generation runs.
/datasets/
/wandb/
