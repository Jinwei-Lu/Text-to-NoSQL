  {
    "record_id": 1003,
    "db_id": "cre_doc_tracking_db",
    "nl_queries": {
      "canonical": "Get the payload field from each document. If the payload is an object type, use that object; otherwise use the payload as is. Output only the resolved payload, without any other fields.",
      "colloquial": "Give me all the stored data from the documents, adjusting any complex values as needed."
    },
    "MQL": "db.All_Documents.aggregate([\n  {\n    \"$addFields\": {\n      \"resolved\": {\n        \"$switch\": {\n          \"branches\": [\n            {\n              \"case\": {\n                \"$eq\": [\n                  {\n                    \"$type\": \"$payload\"\n                  },\n                  \"object\"\n                ]\n              },\n              \"then\": \"$payload\"\n            }\n          ],\n          \"default\": \"$payload\"\n        }\n      }\n    }\n  },\n  {\n    \"$project\": {\n      \"_id\": 0,\n      \"resolved\": 1\n    }\n  }\n])",
    "canonical_form_set": {
      "must_contain": [
        "$switch",
        "$type"
      ],
      "must_not_contain": [
        "$function",
        "$merge",
        "$out",
        "$rand",
        "$sample"
      ],
      "must_contain_at_root": [
        "$addFields",
        "$project"
      ],
      "must_not_contain_at_root": []
    },
    "difficulty": "L4",
