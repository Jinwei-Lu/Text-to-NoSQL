{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tend.dev/schemas/canonical_form_set.schema.json",
  "title": "TEND canonical_form_set",
  "description": "Four-tuple gold-as-class AST membership specification for a record.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "must_contain",
    "must_not_contain",
    "must_contain_at_root",
    "must_not_contain_at_root"
  ],
  "properties": {
    "must_contain": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^\\$[A-Za-z][A-Za-z0-9_]*$"
      },
      "uniqueItems": true,
      "description": "Operators that must appear at any pipeline depth."
    },
    "must_not_contain": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^\\$[A-Za-z][A-Za-z0-9_]*$"
      },
      "uniqueItems": true,
      "description": "Operators forbidden at any depth (includes six disabled ops)."
    },
    "must_contain_at_root": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^\\$[A-Za-z][A-Za-z0-9_]*$"
      },
      "uniqueItems": true,
      "description": "Stage operators required at pipeline root."
    },
    "must_not_contain_at_root": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^\\$[A-Za-z][A-Za-z0-9_]*$"
      },
      "uniqueItems": true,
      "description": "Stage operators forbidden at pipeline root."
    }
  }
}
