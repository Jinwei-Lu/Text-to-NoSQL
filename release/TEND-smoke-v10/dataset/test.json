  {
    "record_id": 1003,
    "db_id": "cre_doc_tracking_db",
    "nl_queries": {
      "canonical": "Retrieve the payload field from all documents in the All_Documents collection, applying a type check that returns the payload unchanged regardless of its type, and output only the payload under the name 'resolved'.",
      "colloquial": "Show me the content of every document."
    },
    "MQL": "db.All_Documents.aggregate([\n  {\n    \"$addFields\": {\n      \"resolved\": {\n        \"$switch\": {\n          \"branches\": [\n            {\n              \"case\": {\n                \"$eq\": [\n                  {\n                    \"$type\": \"$payload\"\n                  },\n                  \"object\"\n                ]\n              },\n              \"then\": \"$payload\"\n            }\n          ],\n          \"default\": \"$payload\"\n        }\n      }\n    }\n  },\n  {\n    \"$project\": {\n      \"_id\": 0,\n      \"resolved\": 1\n    }\n  }\n])",
    "canonical_form_set": {
      "must_contain": [
        "$switch",
        "$type"
      ],
      "must_not_contain": [
        "$function",
        "$merge",
        "$out",
        "$rand",
        "$sample"
      ],
      "must_contain_at_root": [
        "$addFields",
        "$project"
      ],
      "must_not_contain_at_root": []
    },
    "difficulty": "L4",
    "sql_infeasibility_class": "structural_schema_flex",
    "schema_flex": "polymorphic",
    "shape_policy": "reshape",
