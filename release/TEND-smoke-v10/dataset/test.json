  {
    "record_id": 1019,
    "db_id": "cre_doc_tracking_db",
    "nl_queries": {
      "canonical": "Retrieve the first non-null value from each document in the All_Documents collection by checking the payload's v2 field; if that is missing or null, fall back to the v1 field, and if that is also missing or null, use the legacy field. Return only that value for each document.",
      "colloquial": "Get the current value from each document, using the newest version if available."
    },
    "MQL": "db.All_Documents.aggregate([\n  {\n    \"$addFields\": {\n      \"value\": {\n        \"$ifNull\": [\n          \"$payload.v2\",\n          {\n            \"$ifNull\": [\n              \"$payload.v1\",\n              \"$payload.legacy\"\n            ]\n          }\n        ]\n      }\n    }\n  },\n  {\n    \"$project\": {\n      \"_id\": 0,\n      \"value\": 1\n    }\n  }\n])",
    "canonical_form_set": {
