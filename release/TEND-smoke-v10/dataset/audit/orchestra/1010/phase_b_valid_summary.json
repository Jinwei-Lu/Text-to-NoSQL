             ]\n                  }\n                }\n              ]\n            }\n          }\n        }\n      ]\n    }\n  },\n  {\n    \"$project\": {\n      \"kept\": {\n        \"$filter\": {\n          \"input\": \"$per_conductor\",\n          \"as\": \"c\",\n          \"cond\": {\n            \"$gt\": [\n              \"$$c.last_window_avg\",\n              {\n                \"$arrayElemAt\": [\n                  \"$global_median.median\",\n                  0\n                ]\n              }\n            ]\n          }\n        }\n      }\n    }\n  },\n  {\n    \"$unwind\": \"$kept\"\n  },\n  {\n    \"$project\": {\n      \"_id\": 0,\n      \"Name\": \"$kept.Name\",\n      \"last_window_avg\": \"$kept.last_window_avg\"\n    }\n  }\n])",
