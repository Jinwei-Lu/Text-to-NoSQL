{
  "record_id": 2001,
  "db_id": "concert_singer",
  "nl_queries": {
    "canonical": "列出 Capacity 严格大于 5000 的所有体育场，返回 Name 与 Capacity 字段；若 Name 缺失则显示为 (unknown)；不要求排序。",
    "colloquial": "哪些大场馆？"
  },
  "MQL": "db.stadium.aggregate([\n  { $match: { Capacity: { $gt: 5000 } } },\n  { $project: { _id: 0, Name: { $ifNull: [\"$Name\", \"(unknown)\"] }, Capacity: 1 } }\n])",
