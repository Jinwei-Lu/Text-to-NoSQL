{
  "record_id": 5001,
  "db_id": "cre_doc_tracking_db",
  "mutations": [
    {
      "mutation_id": "m001",
      "dimension": "E",
      "subaxis": "assume_uniform_schema",
      "description": "Query static metrics.weight column instead of $objectToArray",
      "MQL": "db.documents.aggregate([{ $group: { _id: null, avg_weight: { $avg: \"$metrics.weight\" } } }])",
      "expected_reject": true
    },
    {
      "mutation_id": "m002",
      "dimension": "A",
      "subaxis": "drop_must_contain_op",
      "description": "Remove $objectToArray; direct field access only",
      "MQL": "db.documents.aggregate([{ $match: { \"metrics.priority\": { $exists: true } } }, { $project: { _id: 0, top_metric: { k: \"priority\", avg_value: \"$metrics.priority\" } } }])",
      "expected_reject": true
    },
    {
      "mutation_id": "m003",
      "dimension": "E",
      "subaxis": "ignore_variants",
      "description": "Skip $unwind on dynamic pairs",
      "MQL": "db.documents.aggregate([{ $project: { pairs: { $objectToArray: \"$metrics\" } } }, { $group: { _id: null, top_metric: { $first: \"$pairs\" } } }])",
      "expected_reject": true
    },
    {
      "mutation_id": "m004",
      "dimension": "B",
      "subaxis": "drop_output_key",
      "description": "Missing top_metric wrapper key",
      "MQL": "db.documents.aggregate([{ $project: { metric_pairs: { $objectToArray: \"$metrics\" } } }, { $unwind: \"$metric_pairs\" }, { $group: { _id: \"$metric_pairs.k\", avg_value: { $avg: { $toDouble: \"$metric_pairs.v\" } } } }])",
      "expected_reject": true
    },
    {
      "mutation_id": "m005",
      "dimension": "D",
      "subaxis": "inject_disabled_op",
      "description": "Inject $sample after unwind",
      "MQL": "db.documents.aggregate([{ $project: { metric_pairs: { $objectToArray: \"$metrics\" } } }, { $unwind: \"$metric_pairs\" }, { $sample: { size: 5 } }, { $group: { _id: \"$metric_pairs.k\", avg_value: { $avg: { $toDouble: \"$metric_pairs.v\" } } } }])",
      "expected_reject": true
    }
  ]
}
