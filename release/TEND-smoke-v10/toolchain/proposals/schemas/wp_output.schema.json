{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tend.dev/schemas/wp_output.schema.json",
  "title": "TEND WP Agent Output",
  "description": "Workload profile produced by WP (Workload Profiler) for a Spider db_id.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "db_id",
    "spider_version",
    "generated_at",
    "insufficient_workload",
    "source",
    "workload_summary",
    "scenario_summary",
    "access_patterns",
    "hot_fields",
    "co_location_signals",
    "join_depth_distribution",
    "aggregation_depth_distribution",
    "design_constraints"
  ],
  "properties": {
    "db_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "spider_version": {
      "type": "string",
      "const": "1.0"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "insufficient_workload": {
      "type": "boolean"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sqlite_path", "tables", "query_count"],
      "properties": {
        "sqlite_path": { "type": "string", "minLength": 1 },
        "tables": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "query_count": { "type": "integer", "minimum": 0 }
      }
    },
    "workload_summary": {
      "type": "string",
      "minLength": 1
    },
    "scenario_summary": {
      "type": "string",
      "minLength": 1,
      "description": "Domain semantics and ≥3 typical business question patterns; no SQL/MQL/operators; consumed by Phase B NLP."
    },
    "access_patterns": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/accessPattern" }
    },
    "hot_fields": {
      "type": "array",
      "items": { "$ref": "#/$defs/hotField" }
    },
    "co_location_signals": {
      "type": "array",
      "items": { "$ref": "#/$defs/coLocationSignal" }
    },
    "join_depth_distribution": {
      "$ref": "#/$defs/proportionMap4"
    },
    "aggregation_depth_distribution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["shallow", "medium", "deep"],
      "properties": {
        "shallow": { "type": "number", "minimum": 0, "maximum": 1 },
        "medium": { "type": "number", "minimum": 0, "maximum": 1 },
        "deep": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "design_constraints": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    }
  },
  "$defs": {
    "accessPattern": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pattern_id",
        "type",
        "tables",
        "frequency",
        "example_query_ids",
        "nl_hints",
        "sql_operators"
      ],
      "properties": {
        "pattern_id": {
          "type": "string",
          "pattern": "^AP[0-9]{2,}$"
        },
        "type": { "type": "string", "minLength": 1 },
        "tables": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "join_path": {
          "oneOf": [
            { "type": "string", "minLength": 1 },
            { "type": "null" }
          ]
        },
        "frequency": { "type": "number", "minimum": 0, "maximum": 1 },
        "example_query_ids": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "integer" }
        },
        "nl_hints": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "sql_operators": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "hotField": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "access_count"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "access_count": { "type": "integer", "minimum": 0 }
      }
    },
    "coLocationSignal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["entities", "co_access_rate"],
      "properties": {
        "entities": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": { "type": "string", "minLength": 1 }
        },
        "co_access_rate": { "type": "number", "minimum": 0, "maximum": 1 },
        "note": { "type": "string" }
      }
    },
    "proportionMap4": {
      "type": "object",
      "additionalProperties": false,
      "required": ["0", "1", "2", "3+"],
      "properties": {
        "0": { "type": "number", "minimum": 0, "maximum": 1 },
        "1": { "type": "number", "minimum": 0, "maximum": 1 },
        "2": { "type": "number", "minimum": 0, "maximum": 1 },
        "3+": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    }
  }
}
