{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tend.dev/schemas/property_verification.schema.json",
  "title": "TEND PV Agent Output",
  "description": "Property verification output from PV (Property Verifier): gold EX, mutation rejections, and plan semantic_properties.",
  "type": "object",
  "additionalProperties": false,
  "required": ["property_verification", "pv_pass", "pv_trace"],
  "properties": {
    "property_verification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["gold_ex", "mutations_ex_all_reject"],
      "properties": {
        "gold_ex": { "type": "boolean" },
        "gold_normexec_non_bot": { "type": "boolean" },
        "mql_alt_ex_equiv": { "type": "boolean" },
        "ast_check_gold": { "type": "boolean" },
        "ast_check_alt": { "type": "boolean" },
        "semantic_properties": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "pass"],
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "pass": { "type": "boolean" },
              "notes": { "type": "string" }
            }
          }
        },
        "mutations_ex_all_reject": { "type": "boolean" },
        "mutation_results": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["mutation_id", "ex"],
            "properties": {
              "mutation_id": {
                "type": "string",
                "pattern": "^m[0-9]{3}$"
              },
              "ex": { "type": "boolean" },
              "ast_check": { "type": "boolean" },
              "notes": { "type": "string" }
            }
          }
        }
      }
    },
    "pv_pass": { "type": "boolean" },
    "pv_trace": {
      "type": "object",
      "additionalProperties": false,
      "required": ["blocking_failures"],
      "properties": {
        "blocking_failures": {
          "type": "array",
          "items": { "type": "string" }
        },
        "reflux_target": {
          "type": ["string", "null"],
          "enum": ["MS", "MUT", null]
        }
      }
    }
  }
}
