    "MQL": "db.account.aggregate([ { \"$lookup\": { \"from\": \"trans\", \"let\": { \"aid\": \"$_id\" }, \"pipeline\": [{ \"$match\": { \"$expr\": { \"$and\": [ { \"$eq\": [\"$account_id\", \"$$aid\"] }, { \"$eq\": [\"$type\", \"PRIJEM\"] } ] } } },{ \"$group\": { \"_id\": null, \"credit_sum\": { \"$sum\": \"$amount\" } } } ], \"as\": \"_credit\" } },{ \"$addFields\": { \"loan_to_credit_ratio\": { \"$cond\": [ { \"$ne\": [ { \"$type\": \"$loan\" }, \"missing\" ] },{ \"$divide\": [ \"$loan.amount\", { \"$max\": [ { \"$ifNull\": [ { \"$arrayElemAt\": [\"$_credit.credit_sum\", 0] }, 0 ] }, 1 ] } ] }, 0 ] } } },{ \"$project\": { \"_credit\": 0 } } ])",
