{
  "_about": "Hand-authored, execution-verified gold TEND cases on the real BIRD `financial` db (migrated via tend.construct.migrate). These are the expected-results oracle for the small-scale run test: each gold MQL is verified on MongoDB to (a) satisfy its thin canonical_form_set (AST_check), (b) be result-equivalent (NormExec ≡_rec) to an independent naive reference oracle R, and (c) be discriminated from a plausible-wrong mutation. See tests/test_manual_cases.py.",
  "cases": [
    {
      "name": "present_missing_loan_ratio",
      "record": {
        "record_id": 1001,
        "db_id": "financial",
        "nl_queries": {
          "canonical": "For each account, add a field loan_to_credit_ratio: if the account has a loan, divide loan.amount by the sum of amount over all of that account's credit transactions (trans.type = 'PRIJEM'), treating a sum of 0 as 1; if the account has no loan, the field is 0. Keep every account document (including those without a loan), adding only this field to the original document without changing the document count or nested structure; no ordering required.",
          "colloquial": "For each account, label its loan amount relative to its credit inflow; accounts with no loan get 0, and don't leave any account out."
        },
        "MQL": "db.account.aggregate([ { \"$lookup\": { \"from\": \"trans\", \"let\": { \"aid\": \"$_id\" }, \"pipeline\": [{ \"$match\": { \"$expr\": { \"$and\": [ { \"$eq\": [\"$account_id\", \"$$aid\"] }, { \"$eq\": [\"$type\", \"PRIJEM\"] } ] } } },{ \"$group\": { \"_id\": null, \"credit_sum\": { \"$sum\": \"$amount\" } } } ], \"as\": \"_credit\" } },{ \"$addFields\": { \"loan_to_credit_ratio\": { \"$cond\": [ { \"$ne\": [ { \"$type\": \"$loan\" }, \"missing\" ] },{ \"$divide\": [ \"$loan.amount\", { \"$max\": [ { \"$ifNull\": [ { \"$arrayElemAt\": [\"$_credit.credit_sum\", 0] }, 0 ] }, 1 ] } ] }, 0 ] } } },{ \"$project\": { \"_credit\": 0 } } ])",
        "canonical_form_set": {
          "must_contain": [
            "$lookup"
          ],
          "must_not_contain": [
            "$$NOW",
            "$function",
            "$merge",
            "$out",
            "$rand",
            "$sample"
          ],
          "must_contain_at_root": [
            "$lookup"
          ],
          "must_not_contain_at_root": [
            "$group",
            "$unwind"
          ]
        },
        "difficulty": "L4",
        "sql_infeasibility_class": "structural_schema_flex",
        "shape_policy": "preserve",
        "schema_flex": "polymorphic"
      },
      "oracle": {
        "template": "present_missing_projection",
        "params": {
          "parent_collection": "account",
          "embed_field": "loan",
          "numerator_path": "loan.amount",
          "target_field": "loan_to_credit_ratio",
          "absent_value": 0,
          "denom": {
            "collection": "trans",
            "local_id": "_id",
            "foreign_field": "account_id",
            "match": {
              "field": "type",
              "value": "PRIJEM"
            },
            "sum_field": "amount",
            "zero_value": 1
          }
        }
      },
      "expect": {
        "shape_policy": "preserve",
        "cardinality_equals_input": "account"
      },
      "mutation": "db.account.aggregate([ { \"$match\": { \"loan\": { \"$exists\": true } } }, { \"$lookup\": { \"from\": \"trans\", \"let\": { \"aid\": \"$_id\" }, \"pipeline\": [{ \"$match\": { \"$expr\": { \"$and\": [ { \"$eq\": [\"$account_id\", \"$$aid\"] }, { \"$eq\": [\"$type\", \"PRIJEM\"] } ] } } },{ \"$group\": { \"_id\": null, \"credit_sum\": { \"$sum\": \"$amount\" } } } ], \"as\": \"_credit\" } },{ \"$addFields\": { \"loan_to_credit_ratio\": { \"$divide\": [ \"$loan.amount\", { \"$max\": [ { \"$ifNull\": [ { \"$arrayElemAt\": [\"$_credit.credit_sum\", 0] }, 0 ] }, 1 ] } ] } } },{ \"$project\": { \"_credit\": 0 } } ])"
    },
    {
      "name": "accounts_per_frequency",
      "record": {
        "record_id": 1002,
        "db_id": "financial",
        "nl_queries": {
          "canonical": "Count the number of accounts for each value of account.frequency (statement frequency), returning each frequency together with its account count.",
          "colloquial": "How many accounts are there for each statement frequency?"
        },
        "MQL": "db.account.aggregate([{\"$group\":{\"_id\":\"$frequency\",\"count\":{\"$sum\":1}}}])",
        "canonical_form_set": {
          "must_contain": [],
          "must_not_contain": [
            "$$NOW",
            "$function",
            "$merge",
            "$out",
            "$rand",
            "$sample"
          ],
          "must_contain_at_root": [
            "$group"
          ],
          "must_not_contain_at_root": []
        },
        "difficulty": "L1",
        "sql_infeasibility_class": "feasible",
        "shape_policy": "reduce"
      },
      "oracle": {
        "template": "group_count",
        "params": {
          "collection": "account",
          "group_by": "frequency"
        }
      },
      "expect": {
        "shape_policy": "reduce",
        "group_key_preserved": "_id"
      },
      "mutation": "db.account.aggregate([{\"$group\":{\"_id\":\"$district_id\",\"count\":{\"$sum\":1}}}])"
    }
  ]
}