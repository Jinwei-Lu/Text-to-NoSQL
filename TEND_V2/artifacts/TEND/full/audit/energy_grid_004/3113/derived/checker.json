{
  "pattern_family": "simple_filter",
  "primary_operator": "$match",
  "must_contain": [
    "$match",
    "$project"
  ],
  "must_contain_at_root": [
    "$match",
    "$project"
  ],
  "query": "db.alerts.aggregate([ { $match: { \"response_hours\": { $gt: 70 } } }, { $project: { _id: 0, severity: 1, response_hours: \"$response_hours\" } }])"
}