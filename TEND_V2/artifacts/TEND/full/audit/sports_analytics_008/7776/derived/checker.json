{
  "pattern_family": "array_positional_select",
  "primary_operator": "$arrayElemAt",
  "must_contain": [
    "$arrayElemAt",
    "$project"
  ],
  "must_contain_at_root": [
    "$project"
  ],
  "query": "db.matches.aggregate([ { $project: { _id: 0, team: 1, first: { $arrayElemAt: [\"$player_ratings\", 0] }, last: { $arrayElemAt: [\"$player_ratings\", -1] }, size: { $size: \"$player_ratings\" } } }])"
}