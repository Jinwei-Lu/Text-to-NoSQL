{
  "pattern_family": "array_positional_select",
  "primary_operator": "$arrayElemAt",
  "must_contain": [
    "$arrayElemAt",
    "$project"
  ],
  "must_contain_at_root": [
    "$project"
  ],
  "query": "db.accounts.aggregate([ { $project: { _id: 0, company: 1, first: { $arrayElemAt: [\"$monthly_volumes\", 0] }, last: { $arrayElemAt: [\"$monthly_volumes\", -1] }, size: { $size: \"$monthly_volumes\" } } }])"
}