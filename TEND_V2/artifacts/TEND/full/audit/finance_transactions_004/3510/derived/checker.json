{
  "pattern_family": "simple_filter",
  "primary_operator": "$match",
  "must_contain": [
    "$match",
    "$project"
  ],
  "must_contain_at_root": [
    "$match",
    "$project"
  ],
  "query": "db.accounts.aggregate([ { $match: { \"risk_score\": { $gt: 70 } } }, { $project: { _id: 0, company: 1, risk_score: \"$risk_score\" } }])"
}