{
  "pattern_family": "simple_filter",
  "primary_operator": "$match",
  "must_contain": [
    "$match",
    "$project"
  ],
  "must_contain_at_root": [
    "$match",
    "$project"
  ],
  "query": "db.events.aggregate([ { $match: { \"attendance\": { $gt: 70 } } }, { $project: { _id: 0, name: 1, attendance: \"$attendance\" } }])"
}