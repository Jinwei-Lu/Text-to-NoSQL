{
  "pattern_family": "array_positional_select",
  "primary_operator": "$arrayElemAt",
  "must_contain": [
    "$arrayElemAt",
    "$project"
  ],
  "must_contain_at_root": [
    "$project"
  ],
  "query": "db.inspections.aggregate([ { $project: { _id: 0, product: 1, first: { $arrayElemAt: [\"$measurements\", 0] }, last: { $arrayElemAt: [\"$measurements\", -1] }, size: { $size: \"$measurements\" } } }])"
}