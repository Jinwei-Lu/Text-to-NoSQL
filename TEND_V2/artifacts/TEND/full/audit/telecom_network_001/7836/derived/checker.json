{
  "pattern_family": "top_k_by_aggregate",
  "primary_operator": "$group",
  "must_contain": [
    "$group",
    "$limit",
    "$sort"
  ],
  "must_contain_at_root": [
    "$group",
    "$limit",
    "$project",
    "$sort"
  ],
  "query": "db.cells.aggregate([ { $group: { _id: \"$tower\", total_value: { $sum: \"$throughput_mbps\" } } }, { $sort: { total_value: -1 } }, { $limit: 3 }, { $project: { _id: 0, tower: \"$_id\", total_value: 1 } }])"
}