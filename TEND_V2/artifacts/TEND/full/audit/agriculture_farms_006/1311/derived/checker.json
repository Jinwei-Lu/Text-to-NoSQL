{
  "pattern_family": "simple_filter",
  "primary_operator": "$match",
  "must_contain": [
    "$match",
    "$project"
  ],
  "must_contain_at_root": [
    "$match",
    "$project"
  ],
  "query": "db.harvests.aggregate([ { $match: { \"yield_tons\": { $gt: 70 } } }, { $project: { _id: 0, farm: 1, yield_tons: \"$yield_tons\" } }])"
}