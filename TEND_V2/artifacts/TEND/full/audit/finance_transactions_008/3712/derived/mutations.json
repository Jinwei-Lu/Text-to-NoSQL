[
  {
    "mutation_id": "wrong_operator",
    "query": "db.accounts.aggregate([ { $match: { \"risk_score\": { $lt: 70 } } }, { $project: { _id: 0, company: 1, risk_score: \"$risk_score\" } }])"
  },
  {
    "mutation_id": "tight_threshold",
    "query": "db.accounts.aggregate([ { $match: { \"risk_score\": { $gt: 90 } } }, { $project: { _id: 0, company: 1, risk_score: \"$risk_score\" } }])"
  }
]