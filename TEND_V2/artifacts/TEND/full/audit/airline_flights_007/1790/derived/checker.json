{
  "pattern_family": "simple_filter",
  "primary_operator": "$match",
  "must_contain": [
    "$match",
    "$project"
  ],
  "must_contain_at_root": [
    "$match",
    "$project"
  ],
  "query": "db.flights.aggregate([ { $match: { \"airline\": { $gt: 70 } } }, { $project: { _id: 0, airline: 1, airline: \"$airline\" } }])"
}