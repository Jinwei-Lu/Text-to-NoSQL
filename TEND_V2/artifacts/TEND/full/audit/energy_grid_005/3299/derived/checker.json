{
  "pattern_family": "array_positional_select",
  "primary_operator": "$arrayElemAt",
  "must_contain": [
    "$arrayElemAt",
    "$project"
  ],
  "must_contain_at_root": [
    "$project"
  ],
  "query": "db.meters.aggregate([ { $project: { _id: 0, city: 1, first: { $arrayElemAt: [\"$daily_readings\", 0] }, last: { $arrayElemAt: [\"$daily_readings\", -1] }, size: { $size: \"$daily_readings\" } } }])"
}