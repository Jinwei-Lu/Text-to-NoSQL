{
  "pattern_family": "array_positional_select",
  "primary_operator": "$arrayElemAt",
  "must_contain": [
    "$arrayElemAt",
    "$project"
  ],
  "must_contain_at_root": [
    "$project"
  ],
  "query": "db.sensors.aggregate([ { $project: { _id: 0, station: 1, first: { $arrayElemAt: [\"$reading_history\", 0] }, last: { $arrayElemAt: [\"$reading_history\", -1] }, size: { $size: \"$reading_history\" } } }])"
}