{
  "pattern_family": "simple_filter",
  "primary_operator": "$match",
  "must_contain": [
    "$match",
    "$project"
  ],
  "must_contain_at_root": [
    "$match",
    "$project"
  ],
  "query": "db.orders.aggregate([ { $match: { \"segment\": { $gt: 70 } } }, { $project: { _id: 0, customer: 1, segment: \"$segment\" } }])"
}