{
  "pattern_family": "top_k_by_aggregate",
  "primary_operator": "$group",
  "must_contain": [
    "$group",
    "$limit",
    "$sort"
  ],
  "must_contain_at_root": [
    "$group",
    "$limit",
    "$project",
    "$sort"
  ],
  "query": "db.products.aggregate([ { $group: { _id: \"$name\", total_value: { $sum: \"$price\" } } }, { $sort: { total_value: -1 } }, { $limit: 3 }, { $project: { _id: 0, name: \"$_id\", total_value: 1 } }])"
}