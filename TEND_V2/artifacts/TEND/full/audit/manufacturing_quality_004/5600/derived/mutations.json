[
  {
    "mutation_id": "wrong_default",
    "query": "db.inspections.aggregate([ { $project: { _id: 0, product: 1, value: { $literal: [\"$line\", 0] } } }, { $sort: { value: -1 } }])"
  },
  {
    "mutation_id": "reverse_sort",
    "query": "db.inspections.aggregate([ { $project: { _id: 0, product: 1, value: { $ifNull: [\"$line\", 0] } } }, { $sort: { value: 1 } }])"
  }
