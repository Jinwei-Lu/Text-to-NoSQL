{
  "pattern_family": "coalesce_with_default",
  "primary_operator": "$ifNull",
  "must_contain": [
    "$ifNull",
    "$project"
  ],
  "must_contain_at_root": [
    "$project",
    "$sort"
  ],
  "query": "db.inspections.aggregate([ { $project: { _id: 0, product: 1, value: { $ifNull: [\"$line\", 0] } } }, { $sort: { value: -1 } }])"
}