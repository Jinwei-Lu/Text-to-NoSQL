{
  "domain_id": "manufacturing_quality",
  "name": "Manufacturing Quality Control",
  "entities": [
    {
      "collection": "inspections",
      "cardinality": 24,
      "fields": [
        { "name": "product", "type": "TEXT" },
        { "name": "line", "type": "TEXT", "values": ["line_A", "line_B", "line_C"] },
        { "name": "shift", "type": "TEXT", "values": ["morning", "afternoon", "night"] },
        { "name": "defect_count", "type": "INT", "range": [0, 50] },
        { "name": "temperature", "type": "REAL", "range": [150.0, 300.0], "nullable": true, "null_rate": 0.07 },
        { "name": "year", "type": "INT", "role": "time", "nullable": false },
        { "name": "measurements", "type": "ARRAY", "min_items": 3, "max_items": 8, "items": { "type": "REAL", "range": [0.1, 10.0], "name": "measurement" } },
        { "name": "is_passed", "type": "BOOL" }
      ]
    }
  ],
  "relations": [],
  "f_topology_hints": { "nested_objects": false, "sparse_embedded": true, "time_series_ready": true },
  "distribution_priors": { "default_cardinality": 24 },
  "phenomenon_blueprints": [
    { "phenomenon_class": "temporal_trend", "collection": "inspections", "path": "defect_count", "intent_hooks": ["window", "trend"] },
    { "phenomenon_class": "outlier", "collection": "inspections", "path": "defect_count", "intent_hooks": ["topk", "anomaly"] },
    { "phenomenon_class": "periodic_pattern", "collection": "inspections", "path": "temperature", "intent_hooks": ["periodic", "cycle"] },
    { "phenomenon_class": "pollution", "collection": "inspections", "path": "line", "intent_hooks": ["dirty_data", "clean"] },
    { "phenomenon_class": "rare_event", "collection": "inspections", "path": "measurements", "intent_hooks": ["rare", "filter"] },
    { "phenomenon_class": "boundary_value", "collection": "inspections", "path": "temperature", "intent_hooks": ["edge_case", "boundary"] }
  ]
}
