{
  "domain_id": "city_sensors",
  "name": "City Sensors",
  "entities": [
    {
      "collection": "sensors",
      "cardinality": 20,
      "fields": [
        { "name": "station", "type": "TEXT", "values": ["S1", "S2", "S3", "S4"], "sparse": false },
        { "name": "zone", "type": "TEXT", "values": ["north", "south", "west"], "sparse": false },
        { "name": "year", "type": "INT", "role": "time", "nullable": false },
        { "name": "reading", "type": "REAL", "range": [10.0, 95.0], "nullable": true, "null_rate": 0.07 },
        { "name": "alert_count", "type": "INT", "range": [0, 15], "nullable": false },
        { "name": "reading_history", "type": "ARRAY", "min_items": 3, "max_items": 6, "items": { "type": "INT", "range": [5, 120], "name": "reading_item" } }
      ]
    }
  ],
  "relations": [],
  "f_topology_hints": {
    "nested_objects": false,
    "sparse_embedded": true,
    "time_series_ready": true
  },
  "distribution_priors": {
    "default_cardinality": 20
  },
  "phenomenon_blueprints": [
    {
      "phenomenon_class": "temporal_trend",
      "collection": "sensors",
      "path": "reading",
      "intent_hooks": ["window", "trend"]
    },
    {
      "phenomenon_class": "outlier",
      "collection": "sensors",
      "path": "alert_count",
      "intent_hooks": ["topk", "anomaly"]
    },
    {
      "phenomenon_class": "pollution",
      "collection": "sensors",
      "path": "zone",
      "intent_hooks": ["facet"]
    },
    {
      "phenomenon_class": "rare_event",
      "collection": "sensors",
      "path": "reading_history",
      "intent_hooks": ["existential"]
    }
  ]
}
