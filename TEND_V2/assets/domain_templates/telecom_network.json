{
  "domain_id": "telecom_network",
  "name": "Telecom Network",
  "entities": [
    {
      "collection": "cells",
      "cardinality": 20,
      "fields": [
        { "name": "tower", "type": "TEXT", "values": ["T1", "T2", "T3", "T4", "T5"], "sparse": false },
        { "name": "region", "type": "TEXT", "values": ["urban", "suburban", "rural"], "sparse": false },
        { "name": "year", "type": "INT", "role": "time", "nullable": false },
        { "name": "throughput_mbps", "type": "REAL", "range": [1.0, 1000.0], "nullable": true, "null_rate": 0.07 },
        { "name": "dropped_calls", "type": "INT", "range": [0, 100], "nullable": false },
        { "name": "signal_strength", "type": "ARRAY", "min_items": 3, "max_items": 6, "items": { "type": "INT", "range": [-120, -30], "name": "signal_item" } },
        { "name": "is_5g", "type": "BOOL", "nullable": false }
      ]
    }
  ],
  "relations": [],
  "f_topology_hints": {
    "nested_objects": false,
    "sparse_embedded": true,
    "time_series_ready": true
  },
  "distribution_priors": {
    "default_cardinality": 20
  },
  "phenomenon_blueprints": [
    {
      "phenomenon_class": "temporal_trend",
      "collection": "cells",
      "path": "throughput_mbps",
      "intent_hooks": ["window", "trend"]
    },
    {
      "phenomenon_class": "outlier",
      "collection": "cells",
      "path": "dropped_calls",
      "intent_hooks": ["topk", "anomaly"]
    },
    {
      "phenomenon_class": "skewed_distribution",
      "collection": "cells",
      "path": "throughput_mbps",
      "intent_hooks": ["histogram", "percentile"]
    },
    {
      "phenomenon_class": "correlation",
      "collection": "cells",
      "path": "throughput_mbps",
      "intent_hooks": ["covariance", "joint"]
    },
    {
      "phenomenon_class": "rare_event",
      "collection": "cells",
      "path": "signal_strength",
      "intent_hooks": ["existential"]
    },
    {
      "phenomenon_class": "high_cardinality",
      "collection": "cells",
      "path": "tower",
      "intent_hooks": ["distinct", "groupby"]
    }
  ]
}
