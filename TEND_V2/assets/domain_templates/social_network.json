{
  "domain_id": "social_network",
  "name": "Social Network",
  "entities": [
    {
      "collection": "posts",
      "cardinality": 25,
      "fields": [
        { "name": "author", "type": "TEXT" },
        { "name": "category", "type": "TEXT", "values": ["tech", "lifestyle", "news", "sports", "science"] },
        { "name": "year", "type": "INT", "role": "time", "nullable": false },
        { "name": "likes", "type": "INT", "range": [0, 5000] },
        { "name": "shares", "type": "INT", "range": [0, 1000], "nullable": true, "null_rate": 0.09 },
        { "name": "engagement_scores", "type": "ARRAY", "min_items": 2, "max_items": 6, "items": { "type": "INT", "range": [1, 100], "name": "score" } },
        { "name": "tags", "type": "ARRAY", "min_items": 1, "max_items": 5, "items": { "type": "TEXT", "values": ["trending", "viral", "breaking", "featured", "popular", "exclusive"], "name": "tag" } },
        { "name": "is_verified", "type": "BOOL" }
      ]
    }
  ],
  "relations": [],
  "f_topology_hints": { "nested_objects": false, "sparse_embedded": true, "time_series_ready": true },
  "distribution_priors": { "default_cardinality": 25 },
  "phenomenon_blueprints": [
    { "phenomenon_class": "high_cardinality", "collection": "posts", "path": "author", "intent_hooks": ["distinct", "cardinality"] },
    { "phenomenon_class": "outlier", "collection": "posts", "path": "likes", "intent_hooks": ["topk", "anomaly"] },
    { "phenomenon_class": "pollution", "collection": "posts", "path": "category", "intent_hooks": ["dirty_data", "clean"] },
    { "phenomenon_class": "temporal_trend", "collection": "posts", "path": "likes", "intent_hooks": ["window", "trend"] },
    { "phenomenon_class": "duplicate_cluster", "collection": "posts", "path": "shares", "intent_hooks": ["dedup", "duplicate"] },
    { "phenomenon_class": "rare_event", "collection": "posts", "path": "engagement_scores", "intent_hooks": ["rare", "filter"] }
  ]
}
