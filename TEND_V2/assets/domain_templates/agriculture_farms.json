{
  "domain_id": "agriculture_farms",
  "name": "Agriculture Farm Data",
  "entities": [
    {
      "collection": "harvests",
      "cardinality": 16,
      "fields": [
        { "name": "farm", "type": "TEXT", "values": ["North_Farm", "South_Farm", "East_Farm", "West_Farm"], "sparse": false },
        { "name": "crop", "type": "TEXT", "values": ["wheat", "rice", "corn", "soybean"], "sparse": false },
        { "name": "year", "type": "INT", "role": "time", "nullable": false },
        { "name": "yield_tons", "type": "REAL", "range": [1.0, 50.0], "nullable": true, "null_rate": 0.09 },
        { "name": "rainfall_mm", "type": "REAL", "range": [0.0, 500.0], "nullable": false },
        { "name": "soil_samples", "type": "ARRAY", "min_items": 3, "max_items": 5, "items": { "type": "REAL", "range": [3.0, 9.0], "name": "ph_item" } },
        { "name": "is_organic", "type": "BOOL", "nullable": false }
      ]
    }
  ],
  "relations": [],
  "f_topology_hints": {
    "nested_objects": false,
    "sparse_embedded": true,
    "time_series_ready": true
  },
  "distribution_priors": {
    "default_cardinality": 16
  },
  "phenomenon_blueprints": [
    {
      "phenomenon_class": "temporal_trend",
      "collection": "harvests",
      "path": "yield_tons",
      "intent_hooks": ["window", "trend"]
    },
    {
      "phenomenon_class": "correlation",
      "collection": "harvests",
      "path": "rainfall_mm",
      "intent_hooks": ["covariance", "joint"]
    },
    {
      "phenomenon_class": "outlier",
      "collection": "harvests",
      "path": "yield_tons",
      "intent_hooks": ["topk", "anomaly"]
    },
    {
      "phenomenon_class": "periodic_pattern",
      "collection": "harvests",
      "path": "rainfall_mm",
      "intent_hooks": ["cycle", "seasonal"]
    },
    {
      "phenomenon_class": "boundary_value",
      "collection": "harvests",
      "path": "yield_tons",
      "intent_hooks": ["range", "edge_case"]
    },
    {
      "phenomenon_class": "type_drift",
      "collection": "harvests",
      "path": "yield_tons",
      "intent_hooks": ["schema", "type_check"]
    }
  ]
}
