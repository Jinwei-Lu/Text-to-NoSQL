{
  "domain_id": "retail_orders",
  "name": "Retail Orders",
  "entities": [
    {
      "collection": "orders",
      "cardinality": 16,
      "fields": [
        { "name": "customer", "type": "TEXT", "values": ["Cora", "Mika", "Ivy", "Noah"], "sparse": false },
        { "name": "segment", "type": "TEXT", "values": ["consumer", "pro", "enterprise"], "sparse": false },
        { "name": "year", "type": "INT", "role": "time", "nullable": false },
        { "name": "amount", "type": "REAL", "range": [30.0, 400.0], "nullable": true, "null_rate": 0.1 },
        { "name": "units", "type": "INT", "range": [1, 12], "nullable": false },
        { "name": "basket_scores", "type": "ARRAY", "min_items": 2, "max_items": 4, "items": { "type": "INT", "range": [1, 100], "name": "basket_score" } }
      ]
    }
  ],
  "relations": [],
  "f_topology_hints": {
    "nested_objects": false,
    "sparse_embedded": true,
    "time_series_ready": true
  },
  "distribution_priors": {
    "default_cardinality": 16
  },
  "phenomenon_blueprints": [
    {
      "phenomenon_class": "high_cardinality",
      "collection": "orders",
      "path": "customer",
      "intent_hooks": ["filter"]
    },
    {
      "phenomenon_class": "temporal_trend",
      "collection": "orders",
      "path": "amount",
      "intent_hooks": ["trend", "aggregate"]
    },
    {
      "phenomenon_class": "outlier",
      "collection": "orders",
      "path": "units",
      "intent_hooks": ["topk"]
    },
    {
      "phenomenon_class": "pollution",
      "collection": "orders",
      "path": "segment",
      "intent_hooks": ["facet", "filter"]
    },
    {
      "phenomenon_class": "rare_event",
      "collection": "orders",
      "path": "basket_scores",
      "intent_hooks": ["existential"]
    }
  ]
}
