{
  "domain_id": "finance_transactions",
  "name": "Finance Transactions",
  "entities": [
    {
      "collection": "accounts",
      "cardinality": 18,
      "fields": [
        { "name": "company", "type": "TEXT" },
        { "name": "branch", "type": "TEXT", "values": ["NYC", "London", "Tokyo", "Singapore"] },
        { "name": "balance", "type": "REAL", "range": [1000.0, 500000.0] },
        { "name": "risk_score", "type": "INT", "range": [1, 100], "nullable": true, "null_rate": 0.06 },
        { "name": "quarter", "type": "INT", "role": "time", "nullable": false },
        { "name": "monthly_volumes", "type": "ARRAY", "min_items": 3, "max_items": 12, "items": { "type": "INT", "range": [100, 10000], "name": "volume" } }
      ]
    },
    {
      "collection": "transactions",
      "cardinality": 25,
      "fields": [
        { "name": "tx_type", "type": "TEXT", "values": ["deposit", "withdrawal", "transfer"] },
        { "name": "amount", "type": "REAL", "range": [1.0, 100000.0] },
        { "name": "status", "type": "TEXT", "values": ["completed", "pending", "failed"] },
        { "name": "year", "type": "INT", "role": "time", "nullable": false }
      ]
    }
  ],
  "relations": [
    { "from": "accounts", "to": "transactions", "type": "lookup_join" }
  ],
  "f_topology_hints": { "nested_objects": false, "sparse_embedded": true, "time_series_ready": true },
  "distribution_priors": { "default_cardinality": 20 },
  "phenomenon_blueprints": [
    { "phenomenon_class": "skewed_distribution", "collection": "transactions", "path": "amount", "intent_hooks": ["percentile", "distribution"] },
    { "phenomenon_class": "outlier", "collection": "accounts", "path": "balance", "intent_hooks": ["topk", "anomaly"] },
    { "phenomenon_class": "boundary_value", "collection": "accounts", "path": "risk_score", "intent_hooks": ["edge_case", "boundary"] },
    { "phenomenon_class": "temporal_trend", "collection": "transactions", "path": "amount", "intent_hooks": ["window", "trend"] },
    { "phenomenon_class": "rare_event", "collection": "accounts", "path": "monthly_volumes", "intent_hooks": ["rare", "filter"] },
    { "phenomenon_class": "correlation", "collection": "accounts", "path": "balance", "intent_hooks": ["correlation", "regression"] }
  ]
}
